#!/bin/sh
# check-docker — runs the upstream flow-promises check inside the
# verify-toolbox container (Quint, Apalache, Java, Pele all containerized).
#
# Usage (same arguments as scripts/check, paths relative to the current folder):
#   check-docker FLOW.qnt [--config FILE] [--view FILE] [--out DIR]
set -eu

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
here=$(cd "$(dirname "$self")/.." && pwd)   # the flow-promises skill dir
skills_dir=$(cd "$here/.." && pwd)

docker image inspect verify-toolbox:latest >/dev/null 2>&1 || {
  echo "The verify-toolbox image is not built. Build it once with:" >&2
  echo "  the verify-toolbox skill's build script (../verify-toolbox/build)" >&2
  exit 2
}

exec docker run --rm -i \
  -v "$skills_dir:/skills:ro" \
  -v "$PWD:/work" -w /work \
  verify-toolbox:latest \
  sh /skills/flow-promises/scripts/check "$@"
